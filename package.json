{
  "name": "ndc.dev",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "run-s build:sass watch",
    "clean": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true})\"",
    "watch": "run-p watch:pug watch:sass",
    "watch:sass": "chokidar \"./sass/**/*.sass\" --command \"npm run build:sass\"",
    "watch:pug": "npm run build:pug -- --watch",
    "build": "run-s clean build:**",
    "build:sass": "sass ./sass/index.sass ./build/index.css --style compressed --no-source-map",
    "build:pug": "node build-pug.js --pretty",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deguchi/template.git"
  },
  "author": "",
  "license": "",
  "bugs": {
    "url": "https://github.com/deguchi/template/issues"
  },
  "homepage": "https://github.com/deguchi/template#readme",
  "overrides": {
    "markdown-it": "^14.2.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "chokidar-cli": "^3.0.0",
    "jstransformer-markdown-it": "^3.0.0",
    "npm-run-all2": "^9.0.3",
    "postcss": "^8.5.8",
    "postcss-cli": "^11.0.1",
    "postcss-scss": "^4.0.9",
    "pug": "^3.0.3",
    "sass": "^1.98.0"
  }
}
